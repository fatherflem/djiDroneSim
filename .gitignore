# Unity-generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE and editor state
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.opendb
*.VC.db

# OS-generated files
.DS_Store
Thumbs.db

# Crash and diagnostic output
sysinfo.txt
*.stackdump

# Python tool caches
__pycache__/
*.py[cod]

# Headless benchmark runner scratch output (the session zip is what gets committed)
/BenchmarkRuns/headless_benchmark_result.json
/BenchmarkRuns/session_*/

# .NET check build output and downloaded Unity reference assemblies
Tools/DotnetChecks/**/bin/
Tools/DotnetChecks/**/obj/
Tools/DotnetChecks/.unity-refs/
!Tools/DotnetChecks/**/*.csproj
